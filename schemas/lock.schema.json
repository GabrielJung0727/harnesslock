{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harnesslock/harnesslock/schemas/lock.schema.json",
  "title": "harnesslock.lock",
  "description": "Resolved, deterministic lockfile generated by `harnesslock lock`. Never contains secret values or hashes of secret values.",
  "type": "object",
  "required": ["lockVersion", "generatedAt", "specHash", "instructions"],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "agentId": { "enum": ["claude-code", "codex", "cursor"] },
    "stringList": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "lockVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "specHash": { "$ref": "#/$defs/fingerprint", "description": "canonical SHA-256 of harnesslock.yaml" },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["presence"],
        "properties": {
          "requested": { "type": "string" },
          "presence": { "enum": ["required", "if_installed", "optional"] }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sourceType", "definedIn", "pinnedInConfigs", "permissions", "configFingerprint", "configFingerprints"],
        "properties": {
          "sourceType": { "enum": ["npm", "uvx", "docker", "local", "http"] },
          "package": { "type": "string" },
          "requestedVersion": { "type": "string" },
          "resolvedVersion": { "type": "string" },
          "resolvedFrom": { "type": "string", "description": "config | node_modules | package-lock | pnpm-lock | npx-cache | uv-tools | uv-cache | pipx | harnesslock.yaml" },
          "definedIn": { "$ref": "#/$defs/stringList" },
          "pinnedInConfigs": { "$ref": "#/$defs/stringList" },
          "requiredEnv": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["required", "value"],
              "properties": { "required": { "type": "boolean" }, "value": { "const": "excluded" } },
              "additionalProperties": false
            }
          },
          "permissions": {
            "type": "object",
            "required": ["allowed"],
            "properties": { "allowed": { "$ref": "#/$defs/stringList" } }
          },
          "configFingerprint": { "$ref": "#/$defs/fingerprint" },
          "configFingerprints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/fingerprint" } }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "agent", "filesCount", "fingerprint"],
        "properties": {
          "path": { "type": "string" },
          "agent": { "$ref": "#/$defs/agentId" },
          "filesCount": { "type": "integer", "minimum": 0 },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["event", "agent", "files", "fingerprint"],
        "properties": {
          "event": { "type": "string" },
          "agent": { "$ref": "#/$defs/agentId" },
          "files": { "$ref": "#/$defs/stringList" },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["agent", "fingerprint"],
        "properties": { "agent": { "$ref": "#/$defs/agentId" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } }
      }
    },
    "agentPermissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sources", "allow", "deny", "ask"],
        "properties": {
          "sources": { "$ref": "#/$defs/stringList" },
          "allow": { "$ref": "#/$defs/stringList" },
          "deny": { "$ref": "#/$defs/stringList" },
          "ask": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "instructions": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["cross-sync", "git-clean", "strict-hash"] },
        "syncGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["files"],
            "properties": {
              "files": { "$ref": "#/$defs/stringList" },
              "canonicalFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        },
        "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/fingerprint" } }
      }
    }
  }
}
