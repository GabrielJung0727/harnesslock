{
  "name": "harnesslock",
  "version": "0.1.0",
  "description": "Vendor-neutral configuration lockfile and drift detector for AI coding agents (Claude Code, OpenAI Codex, Cursor).",
  "license": "Apache-2.0",
  "author": "GabrielJung0727",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielJung0727/harnesslock.git"
  },
  "homepage": "https://gabrieljung0727.github.io/harnesslock/",
  "bugs": {
    "url": "https://github.com/GabrielJung0727/harnesslock/issues"
  },
  "type": "module",
  "bin": {
    "harnesslock": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "lockfile",
    "drift",
    "devtools"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
